<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Learn Skill | Skill Swap</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">
</head>

<body class="dashboard-page">

    <nav class="dashboard-nav">

        <div class="dashboard-logo">
            <div class="small-logo">SS</div>
            <span>Skill Swap</span>
        </div>

        <div class="dashboard-links">
            <a href="/dashboard">Dashboard</a>
            <a href="/browse">Find Skills</a>
            <a href="/profile">Profile</a>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>

    </nav>


    <main class="dashboard-container">

        <section class="dashboard-section">

            <div class="dashboard-card">

                <div class="card-icon">
                    📚
                </div>

                <h1>Learn a Skill</h1>

                <p>
                    Tell us what skill you want to learn.
                </p>

                <form method="POST">

                    <label>Skill</label>

                    <input
                        type="text"
                        name="skill"
                        placeholder="Example: Video Editing"
                        required
                    >


                    <label>Category</label>

                    <input
                        type="text"
                        name="category"
                        placeholder="Example: Technology"
                        required
                    >


                    <label>Level</label>

                    <select name="level" required>

                        <option value="">
                            Select your level
                        </option>

                        <option value="Beginner">
                            Beginner
                        </option>

                        <option value="Intermediate">
                            Intermediate
                        </option>

                        <option value="Advanced">
                            Advanced
                        </option>

                    </select>


                    <label>Description</label>

                    <textarea
                        name="description"
                        rows="5"
                        placeholder="What would you like to learn?"
                        required
                    ></textarea>


                    <button
                        type="submit"
                        class="dashboard-card-button"
                    >
                        Save Learning Goal
                    </button>

                </form>

                <br>

                <a
                    href="/dashboard"
                    class="back-home"
                >
                    ← Back to Dashboard
                </a>

            </div>

        </section>

    </main>

</body>

</html>
